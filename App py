import streamlit as st
from datetime import datetime, timezone

st.set_page_config(
    page_title="OTC Analysis Bot",
    page_icon="📊",
    layout="centered"
)

st.title("📊 OTC Analysis Bot")
st.caption("Quotex OTC • 1-Minute Analysis")

st.warning(
    "Demo analysis only. Quotex OTC ka live data abhi connected nahi hai."
)

pair = st.selectbox(
    "Select OTC Pair",
    ["EUR/AUD OTC", "EUR/USD OTC", "GBP/USD OTC"]
)

st.subheader(f"📈 {pair}")

st.metric("Market Data", "Not Connected")
st.metric("Last Update", "Unavailable")

st.info(
    "BUY/SELL signal tabhi diya jayega jab chart ka fresh data "
    "reliably available ho. Purane ya fake data par signal nahi diya jayega."
)

if st.button("🔄 Check Data Status"):
    st.warning("Live OTC data source abhi available nahi hai.")

st.divider()
st.subheader("📋 Analysis Status")

st.write("• Timeframe: 1 minute")
st.write("• Indicators: RSI (14), Moving Average (9/21)")
st.write("• Automatic trading: Disabled")
st.write("• Data verification: Required")

st.caption(
    "Analysis tool only. Signals profit ki guarantee nahi dete."
)

st.write(
    "Page opened at:",
    datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
)
